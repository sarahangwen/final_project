doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Register Sale - KGL Grocery
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet')
    link(href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/sale.css')

  body
    .top-nav
      .container.d-flex.justify-content-between.align-items-center
        .d-flex.align-items-center
          i.fas.fa-handshake.me-2
          h1.page-title Register Sale
        a.btn.btn-outline-light.back-btn(href='/salesAgentMaganjoDash')
          i.fas.fa-arrow-left.me-2
          | Back to Dashboard

    .container.py-5
      .form-container
        .form-header
          .header-icon
            i.fas.fa-cash-register
          .header-content
            h2.header-title New Sale Record
            p.header-subtitle Enter all sale details to complete the transaction

        if errorMessage
          .alert.alert-danger.alert-dismissible.fade.show(role='alert')
            i.fas.fa-exclamation-circle.me-2
            = errorMessage
            button.btn-close(type='button' data-bs-dismiss='alert')

        if successMessage
          .alert.alert-success.alert-dismissible.fade.show(role='alert')
            i.fas.fa-check-circle.me-2
            = successMessage
            button.btn-close(type='button' data-bs-dismiss='alert')

        form#registerSaleForm.needs-validation(method='POST' action='/addSale' novalidate)
          
          // Produce Information Section
          .form-section
            .section-header
              i.fas.fa-leaf
              h4.section-title Produce Information
            .row.g-3
              .col-md-6
                .form-group
                  label.form-label(for='produceName')
                    | Produce Name 
                    span.required-mark *
                  select#produceName.form-select(name='produceName' required)
                    option(value='') Select a produce...
                    option(value='Maize grains') Maize Grains
                    option(value='Soya beans') Soya Beans
                    option(value='Cow peas') Cow Peas
                    option(value='G-nuts') G-Nuts
                    option(value='Maize') Maize
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please select a produce name

              .col-md-6
                .form-group
                  label.form-label(for='produceType')
                    | Produce Type 
                    span.required-mark *
                  select#produceType.form-select(name='produceType' required)
                    option(value='') Select a type...
                    option(value='Legume') Legume
                    option(value='Cereals') Cereals
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please select a produce type

          // Sale Transaction Details
          .form-section
            .section-header
              i.fas.fa-calendar-alt
              h4.section-title Sale Details
            .row.g-3
              .col-md-6
                .form-group
                  label.form-label(for='saleDate')
                    | Sale Date 
                    span.required-mark *
                  input#saleDate.form-control(type='date' name='saleDate' required)
                  small.form-text Cannot be a future date
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please provide a valid date

              .col-md-6
                .form-group
                  label.form-label(for='saleTime')
                    | Sale Time 
                    span.required-mark *
                  input#saleTime.form-control(type='time' name='saleTime' required)
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please provide a valid time

              .col-md-6
                .form-group
                  label.form-label(for='quantitySold')
                    | Quantity Sold (kg) 
                    span.required-mark *
                  input#quantitySold.form-control(type='number' name='quantitySold' min='1' step='0.1' required placeholder='Enter quantity in kg')
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please enter a valid quantity

              .col-md-6
                .form-group
                  label.form-label(for='pricePerKg')
                    | Price per Kg (UGX) 
                    span.required-mark *
                  .input-group
                    span.input-group-text UGX
                    input#pricePerKg.form-control(type='number' name='pricePerKg' min='1000' step='1' required placeholder='Price per kg')
                  small.form-text Minimum UGX 1,000 per kg
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please enter a valid price

          // Buyer Information Section
          .form-section
            .section-header
              i.fas.fa-user
              h4.section-title Buyer Information
            .row.g-3
              .col-md-6
                .form-group
                  label.form-label(for='buyerName')
                    | Buyer Name 
                    span.required-mark *
                  input#buyerName.form-control(type='text' name='buyerName' minlength='2' required placeholder='Enter buyer name')
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Buyer name must be at least 2 characters

              .col-md-6
                .form-group
                  label.form-label(for='buyerContact')
                    | Buyer Contact 
                    span.required-mark *
                  input#buyerContact.form-control(type='tel' name='buyerContact' pattern='^(07[0-9]{8}|2567[0-9]{8}|\+2567[0-9]{8})$' required placeholder='07XXXXXXXX or +2567XXXXXXXX')
                  small.form-text Format: 07XXXXXXXX or +2567XXXXXXXX
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Enter a valid Ugandan number

          // Location & Payment Section
          .form-section
            .section-header
              i.fas.fa-map-marker-alt
              h4.section-title Branch & Payment
            .row.g-3
              .col-md-6
                .form-group
                  label.form-label(for='branchName')
                    | Branch 
                    span.required-mark *
                  select#branchName.form-select(name='branchName' required)
                    option(value='') Select branch...
                    option(value='Maganjo') Maganjo
                    option(value='Matugga') Matugga
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please select a branch

              .col-md-6
                .form-group
                  label.form-label(for='paymentMode')
                    | Payment Mode 
                    span.required-mark *
                  select#paymentMode.form-select(name='paymentMode' required)
                    option(value='') Select payment mode...
                    option(value='Cash') Cash
                    option(value='mobileMoney') Mobile Money
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please select a payment mode

          // Summary Section
          .form-section.summary-section
            .summary-box
              .summary-row
                .summary-label Total Sale Amount:
                .summary-value#totalAmount UGX 0
              .summary-text#summaryText (Calculated: Quantity × Price per Kg)

          // Action Buttons
          .form-actions.mt-5
            button.btn.btn-primary.btn-submit(type='submit')
              i.fas.fa-check-circle.me-2
              | Register Sale
            a.btn.btn-secondary.btn-cancel(href='/salesAgentMaganjoDash')
              i.fas.fa-times.me-2
              | Cancel

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    
    script.
      const registerSaleForm = document.getElementById('registerSaleForm');
      const saleDate = document.getElementById('saleDate');
      const saleTime = document.getElementById('saleTime');
      const quantitySold = document.getElementById('quantitySold');
      const pricePerKg = document.getElementById('pricePerKg');
      const totalAmount = document.getElementById('totalAmount');
      const buyerContact = document.getElementById('buyerContact');

      // Set today's date as default
      const now = new Date();
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const dd = String(now.getDate()).padStart(2, '0');
      const hh = String(now.getHours()).padStart(2, '0');
      const min = String(now.getMinutes()).padStart(2, '0');
      const today = `${yyyy}-${mm}-${dd}`;

      saleDate.max = today;
      if (!saleDate.value) saleDate.value = today;
      if (!saleTime.value) saleTime.value = `${hh}:${min}`;

      // Calculate total amount
      function calculateTotal() {
        const qty = parseFloat(quantitySold.value) || 0;
        const price = parseFloat(pricePerKg.value) || 0;
        const total = qty * price;
        totalAmount.textContent = total > 0 ? 'UGX ' + total.toLocaleString() : 'UGX 0';
      }

      quantitySold.addEventListener('input', calculateTotal);
      pricePerKg.addEventListener('input', calculateTotal);

      // Handle form submission - show errors only on submit attempt
      registerSaleForm.addEventListener('submit', (event) => {
        // Validate contact number only on submit
        const pattern = /^(07[0-9]{8}|2567[0-9]{8}|\+2567[0-9]{8})$/;
        if (buyerContact.value && !pattern.test(buyerContact.value)) {
          buyerContact.setCustomValidity('Please enter a valid Ugandan number (07XXXXXXXX or +2567XXXXXXXX)');
        } else {
          buyerContact.setCustomValidity('');
        }

        // Validate sale date only on submit
        const selectedDate = saleDate.value ? new Date(saleDate.value) : null;
        const currentDate = new Date(today);
        if (selectedDate && selectedDate > currentDate) {
          saleDate.setCustomValidity('Sale date cannot be in the future.');
        } else {
          saleDate.setCustomValidity('');
        }

        // Check form validity and prevent submission if invalid
        if (!registerSaleForm.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        registerSaleForm.classList.add('was-validated');
      });

