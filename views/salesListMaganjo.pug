doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sales List - Maganjo
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/manager.css')
    link(rel='stylesheet' href='/css/productList.css')

  body
    .dashboard-layout
      aside.sidebar
        .sidebar-header
          h2.sidebar-title KGL Dashboard
          p.sidebar-subtitle Maganjo Branch
        ul
          li
            a(href='/productListMaganjo') Product List
          li
            a(href='/salesListMag') View Sales List
          li
            a(href='/salesPerProductListMaganjo') Sales Per Product
          li
            a(href='/creditSalesListMaganjo') Credit Sales Management
          li
            a#logout-button.logout-button(href='/logout') Logout

      main.main-content
        .dashboard-container
          .page-topbar
            .container.page-topbar-inner
              .topbar-left
                h3.topbar-title Sales List
                p.topbar-subtitle Maganjo branch
          .container.pb-5
            .list-wrapper
              .list-header
                .header-content
                  .d-flex.align-items-center.gap-3
                    .header-icon
                      i.fas.fa-cash-register
                    div
                      h2.header-title Sales Records
                      p.header-subtitle Review and manage all sales transactions from Maganjo branch
                
                .header-stats
                  .stat-item
                    .stat-icon
                      i.fas.fa-receipt
                    .stat-info
                      .stat-label Total Records
                      .stat-value= sales.length
                  // record sale button on the right
                  button.btn.btn-primary(type='button' data-bs-toggle='modal' data-bs-target='#recordSaleModal')
                    i.fas.fa-plus.me-2
                    | Record Sale

              .search-filter-bar
                .search-box
                  i.fas.fa-search
                  input#searchInput.form-control.search-input(type='text' placeholder='Search by produce, buyer name, or contact...')
                
                .filter-info
                  span.badge.bg-info
                    i.fas.fa-info-circle.me-1
                    | Showing #{sales.length} record(s)

              if sales.length
                .table-container
                  .table-responsive
                    table#salesTable.table.professional-table.mb-0
                      thead
                        tr
                          th.col-produce
                            i.fas.fa-leaf.me-2
                            | Name
                          th.col-type
                            i.fas.fa-tag.me-2
                            | Type
                          th.col-date
                            i.fas.fa-calendar.me-2
                            | Date
                          th.col-time
                            i.fas.fa-clock.me-2
                            | Time
                          th.col-quantity
                            i.fas.fa-weight.me-2
                            | Qty  (kg)
                          th.col-price
                            i.fas.fa-coins.me-2
                            | Price/Kg (UGX)
                          th.col-total
                            i.fas.fa-calculator.me-2
                            | Total (UGX)
                          th.col-buyer
                            i.fas.fa-user.me-2
                            | Name
                          th.col-contact
                            i.fas.fa-phone.me-2
                            | Contact
                          th.col-payment
                            i.fas.fa-money-bill.me-2
                            | Payment Mode
                          th.col-actions
                            i.fas.fa-cog.me-2
                            | Actions
                      tbody
                        each sale in sales
                          tr.data-row
                            td.col-produce.fw-semibold
                              span.produce-badge= sale.produceName
                            td.col-type
                              span.type-badge= sale.produceType
                            td.col-date
                              span.date-text= moment(sale.saleDate).format("DD MMM YYYY")
                            td.col-time
                              span.time-text= sale.saleTime
                            td.col-quantity.text-end
                              .quantity-display= sale.quantitySold.toLocaleString() + ' kg'
                            td.col-price.text-end
                              .price-display= 'UGX ' + sale.pricePerKg.toLocaleString()
                            td.col-total.text-end
                              .price-highlight= 'UGX ' + (sale.quantitySold * sale.pricePerKg).toLocaleString()
                            td.col-buyer= sale.buyerName
                            td.col-contact
                              a(href='tel:' + sale.buyerContact title=sale.buyerContact)
                                i.fas.fa-phone.me-1
                                = sale.buyerContact
                            td.col-payment
                              span.payment-badge(class=sale.paymentMode === 'Cash' ? 'badge-cash' : 'badge-mobile')
                                i.fas.fa-money-bill.me-1
                                = sale.paymentMode
                            td.col-actions
                              .action-buttons
                                a.btn-action.btn-edit(href="/updateSale/"+sale._id title='Edit record')
                                  i.fas.fa-edit
                                button.btn-action.btn-delete(type='button' onclick="deleteSale('"+sale._id+"')" title='Delete record')
                                  i.fas.fa-trash-alt
              else
                .empty-state
                  .empty-icon
                    i.fas.fa-inbox
                  .empty-title No Records Found
                  .empty-text No sales records have been added yet for Maganjo branch.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    
    //- Record Sale Modal
    .modal.fade#recordSaleModal(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-lg.modal-dialog-scrollable
        .modal-content
          .modal-header
            .d-flex.align-items-center.gap-3
              .modal-icon
                i.fas.fa-receipt
              .modal-heading
                h2.modal-title New Sale
                p.modal-subtitle Record a Maganjo sale without leaving the list page
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            - const values = formData || {}
            form#registerSaleForm.needs-validation(action='/addingSales' method='POST' novalidate)
              .row.g-3
                .col-md-6
                  label.form-label(for='produceName') Produce Name
                  select#produceName.form-select(name='produceName' required)
                    option(value='') Select Produce
                    option(value='Maize grains') Maize grains
                    option(value='Soya beans') Soya beans
                    option(value='Cow peas') Cow peas
                    option(value='G-nuts') G-nuts
                    option(value='Maize') Maize
                  .invalid-feedback Please select a produce name.

                .col-md-6
                  label.form-label(for='produceType') Produce Type
                  select#produceType.form-select(name='produceType' required)
                    option(value='') Select Type
                    option(value='Legume') Legume
                    option(value='Cereals') Cereals
                  .invalid-feedback Please select a produce type.

                .col-md-6
                  label.form-label(for='saleDate') Date
                  input#saleDate.form-control(type='date' name='saleDate' value=values.saleDate || '' required)
                  .invalid-feedback Please enter a valid sale date.

                .col-md-6
                  label.form-label(for='saleTime') Time
                  input#saleTime.form-control(type='time' name='saleTime' value=values.saleTime || '' required)
                  .invalid-feedback Please enter a valid sale time.

                .col-md-6
                  label.form-label(for='quantitySold') Quantity Sold (kg)
                  input#quantitySold.form-control(type='number' name='quantitySold' min='1' step='1' value=values.quantitySold || '' required)
                  .invalid-feedback Quantity must be at least 1kg.

                .col-md-6
                  label.form-label(for='pricePerKg') Price per Kg (UGX)
                  input#pricePerKg.form-control(type='number' name='pricePerKg' min='1000' step='1' value=values.pricePerKg || '' required)
                  .invalid-feedback Price per kg must be at least UGX 1,000.

                .col-md-6
                  label.form-label(for='buyerName') Buyer Name
                  input#buyerName.form-control(type='text' name='buyerName' minlength='2' pattern="^[A-Za-z\\s'-]{2,}$" value=values.buyerName || '' required)
                  .invalid-feedback Buyer name should contain letters only and be at least 2 characters.

                .col-md-6
                  label.form-label(for='buyerContact') Buyer Contact
                  input#buyerContact.form-control(type='tel' name='buyerContact' pattern='^(07[0-9]{8}|2567[0-9]{8}|\+2567[0-9]{8})$' placeholder='07XXXXXXXX or +2567XXXXXXXX' value=values.buyerContact || '' required)
                  .invalid-feedback Enter a valid Ugandan phone number.

                .col-md-6
                  label.form-label(for='branchName') Branch Name
                  select#branchName.form-select(name='branchName' required)
                    option(value='Maganjo' selected=true) Maganjo
                  .invalid-feedback Branch must be Maganjo.

                .col-md-6
                  label.form-label(for='paymentMode') Payment Mode
                  select#paymentMode.form-select(name='paymentMode' required)
                    option(value='') Select Payment Mode
                    option(value='Cash') Cash
                    option(value='mobileMoney') Mobile Money
                  .invalid-feedback Please select a payment mode.

              .mt-4.d-grid
                button.btn.btn-primary.btn-lg(type='submit') Save Sale Record

    script.
      const searchInput = document.getElementById('searchInput');
      const table = document.getElementById('salesTable');
      const rows = table ? table.getElementsByTagName('tbody')[0].getElementsByTagName('tr') : [];

      // Record Sale form elements (reusing standard sale form logic)
      const registerSaleForm = document.getElementById('registerSaleForm');
      const quantitySold = document.getElementById('quantitySold');
      const pricePerKg = document.getElementById('pricePerKg');
      const saleTotal = document.getElementById('saleTotal');

      function updateSaleTotal() {
        const q = parseFloat(quantitySold && quantitySold.value) || 0;
        const p = parseFloat(pricePerKg && pricePerKg.value) || 0;
        const total = q * p;
        if (saleTotal) saleTotal.textContent = 'UGX ' + total.toLocaleString();
      }

      if (quantitySold) quantitySold.addEventListener('input', updateSaleTotal);
      if (pricePerKg) pricePerKg.addEventListener('input', updateSaleTotal);

      // Use the same date/time defaults and validation as the standalone form
      const saleDate = document.getElementById('saleDate');
      const saleTime = document.getElementById('saleTime');
      const branchName = document.getElementById('branchName');
      const now = new Date();
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const dd = String(now.getDate()).padStart(2, '0');
      const hh = String(now.getHours()).padStart(2, '0');
      const min = String(now.getMinutes()).padStart(2, '0');
      const today = `${yyyy}-${mm}-${dd}`;

      if (saleDate) {
        saleDate.max = today;
        if (!saleDate.value) saleDate.value = today;
      }
      if (saleTime && !saleTime.value) saleTime.value = `${hh}:${min}`;
      if (branchName) branchName.value = 'Maganjo';

      if (registerSaleForm) {
        registerSaleForm.addEventListener('submit', function(event) {
          const selectedDate = saleDate && saleDate.value ? new Date(saleDate.value) : null;
          const currentDate = new Date(today);

          if (selectedDate && selectedDate > currentDate) {
            saleDate.setCustomValidity('Sale date cannot be in the future.');
          } else if (saleDate) {
            saleDate.setCustomValidity('');
          }

          if (branchName && branchName.value !== 'Maganjo') {
            branchName.setCustomValidity('Branch must be Maganjo.');
          } else if (branchName) {
            branchName.setCustomValidity('');
          }

          if (!registerSaleForm.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }

          registerSaleForm.classList.add('was-validated');
        });
      }

        // Re-open modal after successful submission so user can add more
        const shouldReopenModal = !{JSON.stringify(!!successMessage)};
        if (shouldReopenModal) {
          const modalEl = document.getElementById('recordSaleModal');
          if (modalEl) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
          }

          // reset form for next entry but reapply defaults
          if (registerSaleForm) {
            registerSaleForm.reset();
            if (saleDate) {
              saleDate.max = today;
              saleDate.value = today;
            }
            if (saleTime) {
              saleTime.value = `${hh}:${min}`;
            }
            if (branchName) branchName.value = 'Maganjo';
            // clear validation state
            registerSaleForm.classList.remove('was-validated');
          }
        }

      if (searchInput) {
        searchInput.addEventListener('keyup', function() {
          const searchTerm = this.value.toLowerCase();
          let visibleCount = 0;

          Array.from(rows).forEach(row => {
            const text = row.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          // Update filter info
          const filterInfo = document.querySelector('.filter-info .badge');
          if (filterInfo) filterInfo.textContent = visibleCount + ' record(s) shown';
        });
      }

      function deleteSale(id) {
        if (confirm('Are you sure you want to delete this sale record?')) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/deletesaleMaganjo';
          
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'id';
          input.value = id;
          
          form.appendChild(input);
          document.body.appendChild(form);
          form.submit();
        }
      }
