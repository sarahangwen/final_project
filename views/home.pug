doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Karibu Groceries Ltd - Home
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel='stylesheet' href='/css/home.css')

  body
    header.site-header
      .container.nav-wrap
        .brand
          span.brand-badge KGL
          span.brand-name Karibu Groceries Ltd
        nav
          ul.nav-links
            li: a(href='#home') Home
            li: a(href='#about') About
            li: a(href='#operations') Operations
            li: a(href='#contact') Contact
        a.btn.btn-light.login-link(href='/login') Login

    main
      section#home.hero.fade-in
        .container
          .hero-content
            p.eyebrow 🌾 Wholesale Distribution Excellence
            h1 Karibu Groceries Management System
            p.lead
              | Karibu Groceries Ltd is a leading wholesale distributor of premium cereals and legumes. We streamline operations with intelligent stock management, real-time sales tracking, and complete transparency across Maganjo and Matugga branches.
            .hero-actions
              a.btn.btn-primary.btn-lg(href='/login') 
                span.btn-icon 📊
                span Access Dashboard
              a.btn.btn-outline-light.btn-lg(href='#about') 
                span Learn More

      section#about.section-block.fade-in
        .container
          .about-header
            h2.section-title About Karibu Groceries Ltd
            p.section-subtitle
              | Founded on principles of efficiency and transparency, KGL leverages cutting-edge technology to revolutionize agricultural wholesale distribution in East Africa.
          .stats-grid
            .stat-card
              .stat-icon 🏢
              h3 2
              p Operational Branches
              .stat-detail Maganjo & Matugga
            .stat-card
              .stat-icon 👥
              h3 6
              p Dedicated Staff
              .stat-detail 1 Manager + 2 Agents per Branch
            .stat-card
              .stat-icon 📱
              h3 100%
              p Digital Operations
              .stat-detail All Records Digitized

      section#operations.section-block.alt.fade-in
        .container
          h2.section-title Core Operations
          p.section-subtitle Streamlined processes for maximum efficiency and accuracy
          .operations-grid
            article.info-card
              .card-icon 📦
              h3 Procurement Management
              p
                | Efficiently register new stock with produce type, dealer information, quantities, branch allocation, and competitive pricing—all tracked in real-time.
            article.info-card
              .card-icon 💳
              h3 Sales Tracking
              p
                | Record branch transactions with automatic tonnage updates. Complete visibility into every sale, movement, and customer interaction.
            article.info-card
              .card-icon 💰
              h3 Credit Sales System
              p
                | Comprehensive credit management capturing buyer details, locations, contact information, payment terms, and status tracking for secure transactions.
            article.info-card
              .card-icon 🔧
              h3 Branch Operations
              p
                | Each branch operates with dedicated management—one manager overseeing one manager overseeing operations and two sales agents handling customer relationships.

      section#contact.section-block.fade-in
        .container
          .contact-header
            h2.section-title Get in Touch
            p.section-subtitle Need support or have questions? Our team is here to help.
          .contact-grid
            .contact-card
              .contact-icon 📧
              h3 Email
              p.contact-value info@karibugroceries.com
              p.contact-desc Reach us via email
            .contact-card
              .contact-icon 📞
              h3 Phone
              p.contact-value +256-700-000000
              p.contact-desc Call our support team
            .contact-card
              .contact-icon 📍
              h3 Location
              p.contact-value Kampala, Uganda
              p.contact-desc Visit our headquarters

    // Scroll-to-top button
    a#scrollTopBtn(href='#') ↑

    footer
      .footer-container
        .footer-content
          .footer-column
            .footer-brand
              span.footer-badge KGL
              span.footer-name Karibu Groceries Ltd
            p.footer-desc
              | Revolutionizing agricultural wholesale distribution through technology and transparency. Trusted by managers, agents, and partners across Uganda.
            .footer-socials
              a.social-link(href='#', title='Facebook') f
              a.social-link(href='#', title='Twitter') 𝕏
              a.social-link(href='#', title='LinkedIn') in

          .footer-column
            h4.footer-title Quick Links
            ul.footer-links
              li: a(href='#home') Home
              li: a(href='#about') About Us
              li: a(href='#operations') Operations
              li: a(href='#contact') Contact

          .footer-column
            h4.footer-title Branches
            ul.footer-links
              li: a(href='#') Maganjo Branch
              li: a(href='#') Matugga Branch
              li: a(href='#') Management Portal

          .footer-column
            h4.footer-title Support
            ul.footer-links
              li: a(href='#') Help Center
              li: a(href='#') Documentation
              li: a(href='#') Contact Support
              li: a(href='#') Careers

        .footer-bottom
          p &copy; 2025 Karibu Groceries Ltd. All rights reserved.
          p Empowering agricultural wholesale distribution across East Africa. 

    // JavaScript Enhancements
    script.
      // Smooth scroll for anchor links
      document.addEventListener('DOMContentLoaded', function () {
        document.documentElement.classList.add('js-enabled');

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
          anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
            }
          });
        });

        // Scroll-to-top button behavior
        const scrollBtn = document.getElementById('scrollTopBtn');
        window.addEventListener('scroll', function () {
          if (window.scrollY > 300) {
            scrollBtn.style.display = 'block';
          } else {
            scrollBtn.style.display = 'none';
          }
        });

        scrollBtn.addEventListener('click', function (e) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Fade-in animations on scroll
        const faders = document.querySelectorAll('.fade-in');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('show');
              }
            });
          }, { threshold: 0.1 });

          faders.forEach(fader => observer.observe(fader));
        } else {
          faders.forEach(fader => fader.classList.add('show'));
        }
      });
      });
