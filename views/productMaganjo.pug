                  label.form-label(for='dealerName')
                    | Dealer Name 
                    span.required-mark *
                  input#dealerName.form-control(type='text' name='dealerName' minlength='2' value=values.dealerName || '' required placeholder='Enter dealer name')
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Dealer name must be at least 2 characters

              .col-md-6
                .form-group
                  label.form-label(for='contact')
                    | Dealer Contact 
                    span.required-mark *
                  input#contact.form-control(type='tel' name='contact' pattern='^(?:\+256|0)(7\d{8})$' placeholder='07XXXXXXXX or +2567XXXXXXXX' value=values.contact || '' required)
                  small.form-text Format: 07XXXXXXXX or +2567XXXXXXXX
                  .invalid-feedback
