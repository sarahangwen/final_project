                    | Enter a valid Ugandan number

          // Action Buttons
          .form-actions.mt-5
            button.btn.btn-primary.btn-submit(type='submit')
              i.fas.fa-check-circle.me-2
              | Save Stock Record
            a.btn.btn-secondary.btn-cancel(href='/managerMaganjoDash')
              i.fas.fa-times.me-2
              | Cancel

