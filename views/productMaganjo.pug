                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Please select a branch

          // Pricing Section
          .form-section
            .section-header
              i.fas.fa-money-bill-wave
              h4.section-title Pricing
            .row.g-3
              .col-md-6
                .form-group
                  label.form-label(for='cost')
                    | Cost Price (UGX) 
                    span.required-mark *
                  .input-group
                    span.input-group-text UGX
                    input#cost.form-control(type='number' name='cost' min='10000' step='1' value=values.cost || '' required placeholder='10,000')
                  small.form-text Minimum UGX 10,000
                  .invalid-feedback
                    i.fas.fa-times-circle.me-1
                    | Cost must be at least UGX 10,000

              .col-md-6
                .form-group
                  label.form-label(for='sellPrice')
                    | Selling Price (UGX) 
                    span.required-mark *
                  .input-group
