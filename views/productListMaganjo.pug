doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Product List - Maganjo
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/manager.css')
    link(rel='stylesheet' href='/css/productList.css')

  body
    .dashboard-layout
      aside.sidebar
        .sidebar-header
          h2.sidebar-title KGL Dashboard
          p.sidebar-subtitle Maganjo Branch
        ul
          li
            a(href='/productListMaganjo') Product List
          li
            a(href='/salesListMag') View Sales List
          li
            a(href='/salesPerProductListMaganjo') Sales Per Product
          li
            a(href='/creditSalesListMaganjo') Credit Sales Management
          li
            a#logout-button.logout-button(href='/logout') Logout

      main.main-content
        .dashboard-container
          .page-topbar
            .container.page-topbar-inner
              .topbar-left
                h3.topbar-title Product List
                p.topbar-subtitle Maganjo branch
          .container.pb-5
            - const values = formData || {}

            .list-wrapper
              .list-header
                .header-content
                  .d-flex.align-items-center.gap-3
                    .header-icon
                      i.fas.fa-warehouse
                    div
                      h2.header-title Procured Stock Records
                      p.header-subtitle Review and manage all stock records from Maganjo branch
                .header-stats
                  .stat-item
                    .stat-icon
                      i.fas.fa-receipt
                    .stat-info
                      .stat-label Total Records
                      .stat-value= products.length
                  button.btn.btn-primary(type='button' data-bs-toggle='modal' data-bs-target='#addProductModal')
                    i.fas.fa-plus.me-2
                    | Add Product

              if successMessage
                .alert.alert-success.alert-dismissible.fade.show(role='alert')
                  i.fas.fa-check-circle.me-2
                  = successMessage
                  button.btn-close(type='button' data-bs-dismiss='alert')

              if errorMessage
                .alert.alert-danger.alert-dismissible.fade.show(role='alert')
                  i.fas.fa-exclamation-circle.me-2
                  = errorMessage
                  button.btn-close(type='button' data-bs-dismiss='alert')

              .search-filter-bar
                .search-box
                  i.fas.fa-search
                  input#searchInput.form-control.search-input(type='text' placeholder='Search by produce name, dealer, or contact...')

                .filter-info
                  span.badge.bg-info
                    i.fas.fa-info-circle.me-1
                    | Showing #{products.length} record(s)

              if products.length
                .table-container
                  .table-responsive
                    table#productsTable.table.professional-table.mb-0
                      thead
                        tr
                          th.col-produce
                            i.fas.fa-leaf.me-2
                            | Produce Name
                          th.col-type
                            i.fas.fa-tag.me-2
                            | Produce Type
                          th.col-date
                            i.fas.fa-calendar.me-2
                            | Procurement Date
                          th.col-time
                            i.fas.fa-clock.me-2
                            | Procurement Time
                          th.col-tonnage
                            i.fas.fa-weight.me-2
                            | Tonnage (kg)
                          th.col-cost
                            i.fas.fa-coins.me-2
                            | Cost Price (UGX)
                          th.col-dealer
                            i.fas.fa-user-tie.me-2
                            | Dealer Name
                          th.col-contact
                            i.fas.fa-phone.me-2
                            | Dealer Contact
                          th.col-price
                            i.fas.fa-money-bill-wave.me-2
                            | Selling Price (UGX)
                          th.col-actions
                            i.fas.fa-cog.me-2
                            | Actions
                      tbody
                        each product in products
                          tr.data-row
                            td.col-produce.fw-semibold
                              span.produce-badge= product.produceName
                            td.col-type
                              span.type-badge= product.produceType
                            td.col-date
                              span.date-text= moment(product.procureDate).format('DD MMM YYYY')
                            td.col-time
                              span.time-text= product.procureTime
                            td.col-tonnage.text-end
                              .tonnage-display= product.tonnage.toLocaleString() + ' kg'
                            td.col-cost.text-end
                              .price-display= 'UGX ' + product.cost.toLocaleString()
                            td.col-dealer= product.dealerName
                            td.col-contact
                              a(href='tel:' + product.contact title=product.contact)
                                i.fas.fa-phone.me-1
                                = product.contact
                            td.col-price.text-end
                              .price-highlight= 'UGX ' + product.sellPrice.toLocaleString()
                            td.col-actions
                              .action-buttons
                                a.btn-action.btn-edit(href='/updateProduct/' + product._id title='Edit record')
                                  i.fas.fa-edit
                                button.btn-action.btn-delete(type='button' onclick="deleteProduct('" + product._id + "')" title='Delete record')
                                  i.fas.fa-trash-alt
              else
                .empty-state
                  .empty-icon
                    i.fas.fa-inbox
                  .empty-title No Records Found
                  .empty-text No stock records have been added yet for Maganjo branch.
                  button.btn.btn-primary.mt-3(type='button' data-bs-toggle='modal' data-bs-target='#addProductModal')
                    i.fas.fa-plus.me-2
                    | Add First Product

    .modal.fade#addProductModal.product-modal(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-lg.modal-dialog-scrollable
        .modal-content
          .modal-header
            .d-flex.align-items-center.gap-3
              .modal-icon
                i.fas.fa-box-open
              .modal-heading
                h2.modal-title New Stock Record
                p.modal-subtitle Add a Maganjo stock entry without leaving the list page
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            if validationErrors && validationErrors.length
              .alert.alert-warning.alert-dismissible.fade.show(role='alert')
                i.fas.fa-info-circle.me-2
                | Please correct the highlighted errors before submitting.
                ul.validation-list
                  each validationError in validationErrors
                    li= validationError
                button.btn-close(type='button' data-bs-dismiss='alert')

            form#addProductForm.needs-validation(method='POST' action='/productMaganjo' novalidate)
              input(type='hidden' name='branchName' value='Maganjo')

              .modal-form-section
                .section-header
                  i.fas.fa-leaf
                  h4.section-title Produce Information
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='produceName')
                        | Produce Name 
                        span.required-mark *
                      select#produceName.form-select(name='produceName' required)
                        option(value='') Select a produce...
                        option(value='Beans' selected=values.produceName === 'Beans') Beans
                        option(value='Maize Grains' selected=values.produceName === 'Maize Grains') Maize Grains
                        option(value='G-Nuts' selected=values.produceName === 'G-Nuts') G-Nuts
                        option(value='Soya Beans' selected=values.produceName === 'Soya Beans') Soya Beans
                        option(value='Cow Peas' selected=values.produceName === 'Cow Peas') Cow Peas
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please select a produce name

                  .col-md-6
                    .form-group
                      label.form-label(for='produceType')
                        | Produce Type 
                        span.required-mark *
                      select#produceType.form-select(name='produceType' required)
                        option(value='') Select a type...
                        option(value='Legume' selected=values.produceType === 'Legume') Legume
                        option(value='Cereals' selected=values.produceType === 'Cereals') Cereals
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please select a produce type

              .modal-form-section
                .section-header
                  i.fas.fa-calendar-alt
                  h4.section-title Procurement Details
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='procureDate')
                        | Procurement Date 
                        span.required-mark *
                      input#procureDate.form-control(type='date' name='procureDate' value=values.procureDate || '' required)
                      small.form-text Cannot be a future date
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please provide a valid date

                  .col-md-6
                    .form-group
                      label.form-label(for='procureTime')
                        | Procurement Time 
                        span.required-mark *
                      input#procureTime.form-control(type='time' name='procureTime' value=values.procureTime || '' required)
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please provide a valid time

                  .col-md-6
                    .form-group
                      label.form-label(for='tonnage')
                        | Tonnage (kg) 
                        span.required-mark *
                      input#tonnage.form-control(type='number' name='tonnage' min='100' step='1' value=values.tonnage || '' required placeholder='Minimum 100 kg')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Tonnage must be at least 100 kg

              .modal-form-section
                .section-header
                  i.fas.fa-money-bill-wave
                  h4.section-title Pricing
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='cost')
                        | Cost Price (UGX) 
                        span.required-mark *
                      .input-group
                        span.input-group-text UGX
                        input#cost.form-control(type='number' name='cost' min='10000' step='1' value=values.cost || '' required placeholder='10,000')
                      small.form-text Minimum UGX 10,000
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Cost must be at least UGX 10,000

                  .col-md-6
                    .form-group
                      label.form-label(for='sellPrice')
                        | Selling Price (UGX) 
                        span.required-mark *
                      .input-group
                        span.input-group-text UGX
                        input#sellPrice.form-control(type='number' name='sellPrice' min='10000' step='1' value=values.sellPrice || '' required placeholder='10,000')
                      small.form-text Must be >= cost price
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Selling price must be valid and not below cost

              .modal-form-section
                .section-header
                  i.fas.fa-user-tie
                  h4.section-title Dealer Information
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='dealerName')
                        | Dealer Name 
                        span.required-mark *
                      input#dealerName.form-control(type='text' name='dealerName' minlength='2' value=values.dealerName || '' required placeholder='Enter dealer name')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Dealer name must be at least 2 characters

                  .col-md-6
                    .form-group
                      label.form-label(for='contact')
                        | Dealer Contact 
                        span.required-mark *
                      input#contact.form-control(type='tel' name='contact' pattern='^(?:\+256|0)(7\d{8})$' placeholder='07XXXXXXXX or +2567XXXXXXXX' value=values.contact || '' required)
                      small.form-text Format: 07XXXXXXXX or +2567XXXXXXXX
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid Ugandan number

              .modal-summary
                .summary-row
                  .summary-label Total Investment:
                  .summary-value#totalInvestment UGX 0
                .summary-row
                  .summary-label Profit Margin per kg:
                  .summary-value#profitPerKg UGX 0
                .summary-text#summaryText (Calculated: Tonnage × Cost, and Sell Price - Cost Price)

              .form-actions.mt-4
                button.btn.btn-primary.btn-submit(type='submit')
                  i.fas.fa-check-circle.me-2
                  | Save Stock Record
                button.btn.btn-secondary.btn-cancel(type='button' data-bs-dismiss='modal')
                  i.fas.fa-times.me-2
                  | Cancel

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')

    script.
      const shouldOpenAddProductModal = !{JSON.stringify(!!openAddProductModal)};
      const searchInput = document.getElementById('searchInput');
      const table = document.getElementById('productsTable');
      const rows = table ? table.getElementsByTagName('tbody')[0].getElementsByTagName('tr') : [];
      const addProductForm = document.getElementById('addProductForm');
      const procureDate = document.getElementById('procureDate');
      const procureTime = document.getElementById('procureTime');
      const cost = document.getElementById('cost');
      const sellPrice = document.getElementById('sellPrice');
      const tonnage = document.getElementById('tonnage');
      const totalInvestment = document.getElementById('totalInvestment');
      const profitPerKg = document.getElementById('profitPerKg');

      const now = new Date();
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const dd = String(now.getDate()).padStart(2, '0');
      const hh = String(now.getHours()).padStart(2, '0');
      const min = String(now.getMinutes()).padStart(2, '0');
      const today = `${yyyy}-${mm}-${dd}`;

      if (procureDate) {
        procureDate.max = today;
        if (!procureDate.value) {
          procureDate.value = today;
        }
      }

      if (procureTime && !procureTime.value) {
        procureTime.value = `${hh}:${min}`;
      }

      function calculateTotals() {
        if (!tonnage || !cost || !sellPrice || !totalInvestment || !profitPerKg) {
          return;
        }

        const qty = parseFloat(tonnage.value) || 0;
        const costValue = parseFloat(cost.value) || 0;
        const sellValue = parseFloat(sellPrice.value) || 0;
        const total = qty * costValue;
        const profit = sellValue - costValue;

        totalInvestment.textContent = 'UGX ' + total.toLocaleString();
        profitPerKg.textContent = 'UGX ' + profit.toLocaleString();
      }

      if (tonnage) tonnage.addEventListener('input', calculateTotals);
      if (cost) cost.addEventListener('input', calculateTotals);
      if (sellPrice) sellPrice.addEventListener('input', calculateTotals);

      if (addProductForm) {
        addProductForm.addEventListener('submit', function(event) {
          if (!addProductForm.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          addProductForm.classList.add('was-validated');
        });
      }

      calculateTotals();

      if (shouldOpenAddProductModal) {
        const addProductModal = new bootstrap.Modal(document.getElementById('addProductModal'));
        addProductModal.show();
      }

      if (searchInput) {
        searchInput.addEventListener('keyup', function() {
          const searchTerm = this.value.toLowerCase();
          let visibleCount = 0;

          Array.from(rows).forEach(row => {
            const text = row.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          const filterInfo = document.querySelector('.filter-info .badge');
          if (filterInfo) {
            filterInfo.textContent = visibleCount + ' record(s) shown';
          }
        });
      }

      function deleteProduct(id) {
        if (confirm('Are you sure you want to delete this product record? This action cannot be undone.')) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/deleteProduct';

          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'id';
          input.value = id;

          form.appendChild(input);
          document.body.appendChild(form);
          form.submit();
        }
      }
