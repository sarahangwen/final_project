doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Product List - Maganjo
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/productList.css')

  body
    .top-nav
      .container.d-flex.justify-content-between.align-items-center
        .d-flex.align-items-center
          i.fas.fa-list.me-2
          h1.page-title Product List - Maganjo
        a.btn.btn-outline-light.back-btn(href='/managerMaganjoDash')
          i.fas.fa-arrow-left.me-2
          | Back

    .container.py-5
      .list-wrapper
        .list-header
          .header-content
            .d-flex.align-items-center.gap-3
              .header-icon
                i.fas.fa-warehouse
              div
                h2.header-title Procured Stock Records
                p.header-subtitle Review and manage all stock records from Maganjo branch
          
          .header-stats
            .stat-item
              .stat-icon
                i.fas.fa-boxes
              .stat-info
                .stat-label Total Records
                .stat-value= products.length

        .search-filter-bar
          .search-box
            i.fas.fa-search
            input#searchInput.form-control.search-input(type='text' placeholder='Search by produce name, dealer, or contact...')
          
          .filter-info
            span.badge.bg-info
              i.fas.fa-info-circle.me-1
              | Showing #{products.length} record(s)

        if products.length
          .table-container
            .table-responsive
              table#productsTable.table.professional-table.mb-0
                thead
                  tr
                    th.col-produce
                      i.fas.fa-leaf.me-2
                      | Produce Name
                    th.col-type
                      i.fas.fa-tag.me-2
                      | Produce Type
                    th.col-date
                      i.fas.fa-calendar.me-2
                      | Procurement Date
                    th.col-time
                      i.fas.fa-clock.me-2
                      | Procurement Time
                    th.col-tonnage
                      i.fas.fa-weight.me-2
                      | Tonnage (kg)
                    th.col-cost
                      i.fas.fa-coins.me-2
                      | Cost Price (UGX)
                    th.col-dealer
                      i.fas.fa-user-tie.me-2
                      | Dealer Name
                    th.col-contact
                      i.fas.fa-phone.me-2
                      | Dealer Contact
                    th.col-price
                      i.fas.fa-money-bill-wave.me-2
                      | Selling Price (UGX)
                    th.col-actions
                      i.fas.fa-cog.me-2
                      | Actions
                tbody
                  each product in products
                    tr.data-row
                      td.col-produce.fw-semibold
                        span.produce-badge= product.produceName
                      td.col-type
                        span.type-badge= product.produceType
                      td.col-date
                        span.date-text= moment(product.procureDate).format("DD MMM YYYY")
                      td.col-time
                        span.time-text= product.procureTime
                      td.col-tonnage.text-end
                        .tonnage-display= product.tonnage.toLocaleString() + ' kg'
                      td.col-cost.text-end
                        .price-display= 'UGX ' + product.cost.toLocaleString()
                      td.col-dealer= product.dealerName
                      td.col-contact
                        a(href='tel:' + product.contact title=product.contact)
                          i.fas.fa-phone.me-1
                          = product.contact
                      td.col-price.text-end
                        .price-highlight= 'UGX ' + product.sellPrice.toLocaleString()
                      td.col-actions
                        .action-buttons
                          a.btn-action.btn-edit(href="/updateProduct/"+product._id title='Edit record')
                            i.fas.fa-edit
                          button.btn-action.btn-delete(type='button' onclick="deleteProduct('"+product._id+"')" title='Delete record')
                            i.fas.fa-trash-alt
        else
          .empty-state
            .empty-icon
              i.fas.fa-inbox
            .empty-title No Records Found
            .empty-text No stock records have been added yet for Maganjo branch.
            a.btn.btn-primary.mt-3(href='/productMaganjo')
              i.fas.fa-plus.me-2
              | Add First Product

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    
    script.
      const searchInput = document.getElementById('searchInput');
      const table = document.getElementById('productsTable');
      const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

      searchInput.addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        let visibleCount = 0;

        Array.from(rows).forEach(row => {
          const text = row.textContent.toLowerCase();
          if (text.includes(searchTerm)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Update filter info
        const filterInfo = document.querySelector('.filter-info .badge');
        filterInfo.textContent = visibleCount + ' record(s) shown';
      });

      function deleteProduct(id) {
        if (confirm('Are you sure you want to delete this product record? This action cannot be undone.')) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/deleteProduct';
          
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'id';
          input.value = id;
          
          form.appendChild(input);
          document.body.appendChild(form);
          form.submit();
        }
      }
