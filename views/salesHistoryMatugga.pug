doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Sales History
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css', rel='stylesheet')
    link(rel='stylesheet', href='/css/manager.css')
    link(rel="stylesheet", href="/css/salesHistory.css")
  body
    .dashboard-layout
      aside.sidebar
        .sidebar-header
          h2.sidebar-title KGL Dashboard
          p.sidebar-subtitle Matugga Branch
        ul
          li
            a(href='/salesAtMatugga') View Sales
          li
            a(href='/salesAgentMatuggaDash') Dashboard
          li
            a#logout-button.logout-button(href='/logout') Logout

      main.main-content
        .dashboard-container
          section
            table
              thead
                tr
                  th Date
                  th Product
                  th Quantity (kg)
                  th Price per Kg (UGX)
                  th Total (UGX)
              tbody
              if sales && sales.length 
                each sale in sales
                  tr
                    td #{moment(sale.saleDate).format("DD-MM-YYYY")}
                    td #{sale.produceName}
                  td #{sale.quantitySold}
                  td #{sale.pricePerKg}
                  td #{sale.pricePerKg * sale.quantitySold}
            //- else
            //-   p No sales history available.

    //- footer
