doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Credit Sales Management - KGL
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet', href='/css/manager.css')
    link(rel='stylesheet', href='/css/productList.css')
  body
    .dashboard-layout
      aside.sidebar
        .sidebar-header
          h2.sidebar-title KGL Dashboard
          p.sidebar-subtitle Maganjo Branch
        ul
          li
            a(href='/productListMaganjo') Product List
          li
            a(href='/salesListMag') View Sales List
          li
            a(href='/salesPerProductListMaganjo') Sales Per Product
          li
            a(href='/creditSalesListMaganjo') Credit Sales Management
          li
            a#logout-button.logout-button(href='/logout') Logout

      main.main-content
        .dashboard-container
          .page-topbar
            .container.page-topbar-inner
              .topbar-left
                h3.topbar-title Credit Sales Management
                p.topbar-subtitle Maganjo branch

          .list-card
            .list-header
              .list-header-content
                h3.mb-1 Credit Records - Maganjo
                p.mb-0 Track outstanding customer credit transactions.
              .list-header-actions
                button.btn.btn-primary(type='button' data-bs-toggle='modal' data-bs-target='#addCreditModal')
                  i.fas.fa-plus.me-2
                  | Record Credit Sale
          .search-filter-bar.mt-3
            .search-box
              i.fas.fa-search
              input#creditSearch.form-control.search-input(type='text' placeholder='Search by buyer, produce, agent...')

            .filter-info
              span.badge.bg-info
                i.fas.fa-info-circle.me-1
                | Showing #{credits && credits.length ? credits.length : 0} record(s)

          .record-count
            span.count-label Total Records
            span.count-value= credits && credits.length ? credits.length : 0

        .table-responsive
          table#procuredTable.table.align-middle.mb-0
            thead
              tr
                th Buyer
                th National ID
                th Produce
                th Tonnage (kg)
                th Amount Due (UGX)
                th Due Date
                th Sales Agent
                th Status
                th Action
            tbody
              if credits && credits.length
                each credit in credits
                  tr
                    td.fw-semibold #{credit.creditBuyerName}
                    td #{credit.nationalId}
                    td #{credit.creditProduceName}
                    td #{credit.creditTonnage.toLocaleString()}
                    td #{credit.amountDue.toLocaleString()}
                    td #{new Date(credit.dueDate).toLocaleDateString()}
                    td #{credit.creditSalesAgentName}
                    td
                      span.branch-badge #{credit.status}
                    td
                      a.btn.btn-sm.btn-outline-primary(href="/updateCreditMaganjo/" + credit._id) Update
              else
                tr
                  td.empty-state(colspan='9') No credit sales records found.

    //- Add Credit Modal (reuses exact form from creditMaganjo.pug)
    .modal.fade#addCreditModal(tabindex='-1' aria-hidden='true')
      .modal-dialog.modal-xl.modal-dialog-scrollable
        .modal-content
          .modal-header
            .d-flex.align-items-center.gap-3
              .modal-icon
                i.fas.fa-credit-card
              .modal-heading
                h2.modal-title New Credit Sale
                p.modal-subtitle Add a Maganjo credit sale without leaving the list page
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            - const values = formData || {}
            form#credit-sales-form.needs-validation(action='/creditSaleMaganjo' method='POST' novalidate)
              // Produce Information Section
              .form-section
                .section-header
                  i.fas.fa-leaf
                  h4.section-title Produce Information
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='credit-produce-name')
                        | Produce Name 
                        span.required-mark *
                      select#credit-produce-name.form-select(name='creditProduceName' required)
                        option(value='') Select Produce
                        option(value='Beans' selected=values.creditProduceName === 'Beans') Beans
                        option(value='Maize Grains' selected=values.creditProduceName === 'Maize Grains') Maize Grains
                        option(value='G-Nuts' selected=values.creditProduceName === 'G-Nuts') G-Nuts
                        option(value='Soya Beans' selected=values.creditProduceName === 'Soya Beans') Soya Beans
                        option(value='Cow Peas' selected=values.creditProduceName === 'Cow Peas') Cow Peas
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please select a produce name

                  .col-md-6
                    .form-group
                      label.form-label(for='type-of-produce')
                        | Produce Type 
                        span.required-mark *
                      select#type-of-produce.form-select(name='typeOfProduce' required)
                        option(value='') Select Type
                        option(value='Legume' selected=values.typeOfProduce === 'Legume') Legume
                        option(value='Cereals' selected=values.typeOfProduce === 'Cereals') Cereals
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please select a produce type

              // Buyer Information Section
              .form-section
                .section-header
                  i.fas.fa-user
                  h4.section-title Buyer Information
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='credit-buyer-name')
                        | Buyer Name 
                        span.required-mark *
                      input#credit-buyer-name.form-control(type='text' name='creditBuyerName' minlength='2' pattern="^[A-Za-z\\s'-]{2,}$" value=values.creditBuyerName || '' required placeholder='Enter buyer name')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid buyer name

                  .col-md-6
                    .form-group
                      label.form-label(for='contact')
                        | Buyer Contact 
                        span.required-mark *
                      input#contact.form-control(type='tel' name='contact' pattern='^(?:\+256|0)(7\d{8})$' placeholder='07XXXXXXXX or +2567XXXXXXXX' value=values.contact || '' required)
                      small.form-text Format: 07XXXXXXXX or +2567XXXXXXXX
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid phone number

                  .col-md-6
                    .form-group
                      label.form-label(for='national-id')
                        | National ID 
                        span.required-mark *
                      input#national-id.form-control(type='text' name='nationalId' pattern='^C[A-Z0-9]{13}$' value=values.nationalId || '' required placeholder='Enter national ID')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid National ID

                  .col-md-6
                    .form-group
                      label.form-label(for='location')
                        | Location 
                        span.required-mark *
                      input#location.form-control(type='text' name='location' minlength='2' value=values.location || '' required placeholder='Enter buyer location')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Location is required

              // Credit Amount Section
              .form-section
                .section-header
                  i.fas.fa-money-bill-wave
                  h4.section-title Credit Amount
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='credit-tonnage')
                        | Tonnage (kg) 
                        span.required-mark *
                      input#credit-tonnage.form-control(type='number' name='creditTonnage' min='1' step='1' value=values.creditTonnage || '' required placeholder='Enter tonnage in kg')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Tonnage must be at least 1kg

                  .col-md-6
                    .form-group
                      label.form-label(for='amount-due')
                        | Amount Due (UGX) 
                        span.required-mark *
                      .input-group
                        span.input-group-text UGX
                        input#amount-due.form-control(type='number' name='amountDue' min='10000' step='1' value=values.amountDue || '' required placeholder='Amount due')
                      small.form-text Minimum UGX 10,000
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Amount due must be at least UGX 10,000

              // Credit Terms Section
              .form-section
                .section-header
                  i.fas.fa-calendar-check
                  h4.section-title Credit Terms
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='due-date')
                        | Due Date 
                        span.required-mark *
                      input#due-date.form-control(type='date' name='dueDate' value=values.dueDate || '' required)
                      small.form-text Must be a future date
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid due date

                  .col-md-6
                    .form-group
                      label.form-label(for='date-of-dispatch')
                        | Date of Dispatch 
                        span.required-mark *
                      input#date-of-dispatch.form-control(type='date' name='dateOfDispatch' value=values.dateOfDispatch || '' required)
                      small.form-text Cannot be a future date
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid dispatch date

                  .col-md-6
                    .form-group
                      label.form-label(for='status')
                        | Credit Status 
                        span.required-mark *
                      select#status.form-select(name='status' required)
                        option(value='Pending') Pending
                        option(value='Paid') Paid
                        option(value='Overdue') Overdue
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Please select a status

              // Branch & Agent Section
              .form-section
                .section-header
                  i.fas.fa-building
                  h4.section-title Branch & Agent
                .row.g-3
                  .col-md-6
                    .form-group
                      label.form-label(for='credit-branch-name')
                        | Branch Name 
                        span.required-mark *
                      select#credit-branch-name.form-select(name='creditBranchName' required)
                        option(value='Maganjo' selected=true) Maganjo
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Branch must be Maganjo

                  .col-md-6
                    .form-group
                      label.form-label(for='credit-sales-agent-name')
                        | Sales Agent Name 
                        span.required-mark *
                      input#credit-sales-agent-name.form-control(type='text' name='creditSalesAgentName' minlength='2' pattern="^[A-Za-z\\s'-]{2,}$" value=values.creditSalesAgentName || '' required placeholder='Enter agent name')
                      .invalid-feedback
                        i.fas.fa-times-circle.me-1
                        | Enter a valid sales agent name

              // Action Buttons
              .form-actions.mt-5
                button.btn.btn-primary.btn-submit(type='submit')
                  i.fas.fa-check-circle.me-2
                  | Save Credit Record
                button.btn.btn-secondary.btn-cancel(type='button' data-bs-dismiss='modal')
                  i.fas.fa-times.me-2
                  | Cancel

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz' crossorigin='anonymous')
    script(src='/js/sidebar-active.js')

    script.
      (function() {
        const form = document.getElementById('credit-sales-form');
        if (!form) return;
        
        const dueDate = document.getElementById('due-date');
        const dispatchDate = document.getElementById('date-of-dispatch');
        const branchSelect = document.getElementById('credit-branch-name');
        const today = new Date().toISOString().split('T')[0];

        if (dueDate) dueDate.min = today;
        if (dispatchDate) dispatchDate.max = today;
        if (branchSelect) branchSelect.value = 'Maganjo';

        form.addEventListener('submit', (event) => {
          if (dueDate && new Date(dueDate.value) < new Date(today)) {
            dueDate.setCustomValidity('Due date cannot be in the past.');
          } else if (dueDate) {
            dueDate.setCustomValidity('');
          }

          if (branchSelect && branchSelect.value !== 'Maganjo') {
            branchSelect.setCustomValidity('Branch must be Maganjo.');
          } else if (branchSelect) {
            branchSelect.setCustomValidity('');
          }

          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }

          form.classList.add('was-validated');
        });
      })();

      script.
        (function(){
          const searchInput = document.getElementById('creditSearch');
          const table = document.getElementById('procuredTable');
          const rows = table ? table.getElementsByTagName('tbody')[0].getElementsByTagName('tr') : [];

          if (searchInput) {
            searchInput.addEventListener('keyup', function(){
              const term = this.value.toLowerCase();
              let visible = 0;
              Array.from(rows).forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(term)) { row.style.display = ''; visible++; } else { row.style.display = 'none'; }
              });
              const info = document.querySelector('.filter-info .badge');
              if (info) info.textContent = visible + ' record(s) shown';
            });
          }
        })();
